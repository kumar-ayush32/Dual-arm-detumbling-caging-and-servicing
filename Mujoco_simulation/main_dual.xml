<mujoco model="Dual Robot Arm in Space">
    <option gravity="0 0 0" />
    <default>
        <default class="joint">
            <joint damping="1" />
        </default>
    </default>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="-130" elevation="-60" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="1 1 1" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <asset>
        <model name="Base"    file="models/Base.xml" />
        <model name="Hip"     file="models/Hip.xml" />
        <model name="Hindarm" file="models/Hindarm.xml" />
        <model name="Forearm" file="models/Forearm.xml" />
        <model name="Wrist"   file="models/Wrist.xml" />
        <model name="Hand"    file="models/Hand.xml" />
        <model name="Gripper" file="models/Gripper.xml" />
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
        
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
        <body name="platform" pos="0 0 0.080">

            <inertial mass="200"
                      pos="0 0 0.015"
                      diaginertia="0.8 0.8 1.4" />

            <geom name="platform_beam"
                  type="box"
                  size="0.36 0.04 0.015"
                  pos="0 0 0.015"
                  rgba="0.25 0.25 0.30 1" />

            <body name="base_a" pos="-0.36 0 0">
                <inertial mass="5" pos="0 0 0.03" diaginertia="0.01 0.01 0.01" />
                <attach model="Base" body="Base" prefix="base_a_" />

                <body pos="0 0 0.065">
                    <attach model="Hip" body="Hip" prefix="hip_a_" />

                    <body pos="0 0 0.1655" euler="-90 0 -90">
                        <attach model="Hindarm" body="Hindarm" prefix="hindarm_a_" />
                        <joint class="joint" name="joint_hindarm_a" />

                        <body pos="0.22112 0 0">
                            <attach model="Forearm" body="Forearm" prefix="forearm_a_" />
                            <joint class="joint" name="joint_forearm_a" />

                            <body pos="0.1275 0 0" euler="0 90 90">
                                <attach model="Wrist" body="Wrist" prefix="wrist_a_" />

                                <body pos="0 0 0.095" euler="-90 0 -90">
                                    <attach model="Hand" body="Hand" prefix="hand_a_" />
                                    <joint class="joint" name="joint_hand_a" />

                                    <body pos="0.041 0 0" euler="0 0 0">
                                        <attach model="Gripper" body="Gripper" prefix="gripper_a_" />
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
            <body name="base_b" pos="0.36 0 0" euler="0 0 180">
                <inertial mass="5" pos="0 0 0.03" diaginertia="0.01 0.01 0.01" />
                <attach model="Base" body="Base" prefix="base_b_" />

                <body pos="0 0 0.065">
                    <attach model="Hip" body="Hip" prefix="hip_b_" />

                    <body pos="0 0 0.1655" euler="-90 0 -90">
                        <attach model="Hindarm" body="Hindarm" prefix="hindarm_b_" />
                        <joint class="joint" name="joint_hindarm_b" />

                        <body pos="0.22112 0 0">
                            <attach model="Forearm" body="Forearm" prefix="forearm_b_" />
                            <joint class="joint" name="joint_forearm_b" />

                            <body pos="0.1275 0 0" euler="0 90 90">
                                <attach model="Wrist" body="Wrist" prefix="wrist_b_" />

                                <body pos="0 0 0.095" euler="-90 0 -90">
                                    <attach model="Hand" body="Hand" prefix="hand_b_" />
                                    <joint class="joint" name="joint_hand_b" />

                                    <body pos="0.041 0 0" euler="0 0 0">
                                        <attach model="Gripper" body="Gripper" prefix="gripper_b_" />
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

        </body>
    </worldbody>

    <keyframe>
        <key name="home"
            qpos="0 0 0 0 0 0"/>
    </keyframe>

    <actuator>
        <position joint="joint_hindarm_a" name="hindarm_ctrl_a" kp="70" kv="1"   />
        <position joint="joint_forearm_a" name="forearm_ctrl_a" kp="50" kv="0"   />
        <position joint="joint_hand_a"    name="hand_ctrl_a"    kp="30" kv="0.0" />

        <position joint="joint_hindarm_b" name="hindarm_ctrl_b" kp="70" kv="1"   />
        <position joint="joint_forearm_b" name="forearm_ctrl_b" kp="50" kv="0"   />
        <position joint="joint_hand_b"    name="hand_ctrl_b"    kp="30" kv="0.0" />
    </actuator>
</mujoco>